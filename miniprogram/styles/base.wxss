page{--ink:#202634;--muted:#717684;--accent:#276653;--line:#e9ecf2;--soft:#f5f7f5;background:#fff;color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue',sans-serif;font-size:28rpx;line-height:1.6}

view,text,button,input,textarea{box-sizing:border-box}
button{font:inherit;margin:0;padding:0;background:none;border:0;line-height:1.5;border-radius:0}
button::after{border:0}
button[disabled]{opacity:.42}
image{display:block}
input,textarea{font:inherit}
.app{padding:22rpx 36rpx 200rpx}
.topline{display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:22rpx;letter-spacing:1rpx;margin-bottom:28rpx}
.mode-tag{font-size:20rpx;padding:4rpx 12rpx;background:var(--soft);border-radius:8rpx;letter-spacing:0}
.page-title{font-size:44rpx;font-weight:600;line-height:1.4;letter-spacing:-1rpx;margin-bottom:10rpx}
.home-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:30rpx}
.home-heading .page-title{font-size:46rpx}
.muted{font-size:25rpx;color:var(--muted);line-height:1.6}
.couple{display:flex;padding-left:16rpx}
.couple text{width:62rpx;height:62rpx;line-height:58rpx;text-align:center;background:#e5eee8;color:#276653;border:4rpx solid white;border-radius:50%;font-size:24rpx}
.couple text+text{margin-left:-16rpx;background:#f7e6e8;color:#ad5264}
.together-card,.board-banner{background:#244e42;color:#fff;border-radius:28rpx;padding:30rpx 32rpx;position:relative}
.card-top,.card-bottom{display:flex;justify-content:space-between;align-items:center;font-size:23rpx}
.card-top{color:#e7efe9}
.card-status{border:1rpx solid #6b8a7b;border-radius:20rpx;padding:2rpx 12rpx;font-size:20rpx}
.day-count{display:flex;align-items:center;gap:22rpx;margin:8rpx 0 18rpx}
.day-count>text{font-family:Georgia,'Times New Roman',serif;font-size:116rpx;line-height:1.25;font-weight:400}
.day-count>view{font-size:28rpx}
.day-count>view>text{display:block;color:#e0e9e2;font-size:22rpx;margin-top:4rpx}
.card-bottom{border-top:1rpx solid #58776b;padding-top:20rpx;color:#e7efe9;font-size:23rpx}
.icon{width:34rpx;height:34rpx}
.stats{display:flex;padding:30rpx 0;border-bottom:1rpx solid var(--line);margin-bottom:30rpx}
.stats>view{width:33.333%;text-align:center;border-right:1rpx solid var(--line);color:var(--muted);font-size:22rpx}
.stats>view:last-child{border:0}
.stats text{display:block}
.stats .number{font-size:42rpx;line-height:1.3;font-weight:500;color:var(--ink);margin-bottom:7rpx;font-variant-numeric:tabular-nums}
.stats .denominator{display:inline;font-size:23rpx;color:var(--muted);font-weight:400}
.section-heading{display:flex;justify-content:space-between;align-items:center;margin:30rpx 0 20rpx;font-size:30rpx;font-weight:600}
.link{font-size:24rpx;font-weight:400;color:var(--accent);padding:12rpx 0}
.quick-plans{display:flex;gap:14rpx}
.quick-plans>view{flex:1;min-width:0;background:var(--soft);border:1rpx solid #eaf0eb;border-radius:22rpx;padding:24rpx 12rpx;text-align:center}
.plan-icon{width:44rpx;height:44rpx}
.quick-plans .plan-icon{margin:0 auto 16rpx}
.quick-plans>view>view{font-size:26rpx;font-weight:500}
.quick-plans>view>text{display:block;font-size:20rpx;color:var(--muted);margin-top:6rpx;white-space:nowrap}
.panel,.plan-detail{border:1rpx solid var(--line);border-radius:24rpx;padding:28rpx;margin-top:26rpx}
.section-title{font-size:34rpx;font-weight:600;line-height:1.5;margin:4rpx 0 12rpx}
.section-title.small{font-size:30rpx}
.eyebrow{font-size:21rpx;color:var(--accent);letter-spacing:1rpx}
.primary{display:block!important;width:100%!important;max-width:none!important;background:var(--accent);color:#fff;border-radius:18rpx;padding:25rpx 20rpx;font-size:28rpx;font-weight:500;margin-top:24rpx}
.secondary{background:var(--soft);color:var(--ink);padding:18rpx 26rpx;border-radius:14rpx;font-size:26rpx}
.text-button{font-size:24rpx;color:var(--accent);padding:20rpx 10rpx;text-align:center;display:block}
.input-row{display:flex;gap:12rpx;margin-top:20rpx;align-items:center}
.input-row input{flex:1;width:0;border:1rpx solid var(--line);border-radius:12rpx;height:80rpx;padding:16rpx;font-size:24rpx}
.invite{font-size:32rpx;padding:24rpx 0;letter-spacing:2rpx;overflow-wrap:anywhere}
.invite text{display:block;font-size:21rpx;color:var(--muted);letter-spacing:0}
.active-panel{background:#f3f7f4;border-color:#dae8de}
.activity-info{margin-top:20rpx;font-size:26rpx}
.actions{display:flex;justify-content:space-between;gap:14rpx;margin-top:12rpx;color:var(--muted);font-size:24rpx}
.actions>text{padding:14rpx 0}
.success{padding:24rpx 0 10rpx;color:#287450}
.memory{padding:26rpx 0;border-bottom:1rpx solid var(--line)}
.date{font-size:22rpx;color:var(--muted);margin-bottom:10rpx}
.memory-title{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:500;margin-bottom:6rpx}
.memory-title>text{font-size:24rpx;color:var(--accent);font-weight:500}
.note{font-size:28rpx;line-height:1.85;margin-top:20rpx;white-space:pre-wrap;overflow-wrap:anywhere}
.location{font-size:24rpx;color:var(--muted)}
.memory-footer{display:flex;align-items:center;justify-content:space-between;font-size:21rpx;color:var(--muted);margin-top:14rpx}
.activity-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14rpx;margin-top:32rpx}
.activity{position:relative;border:2rpx solid var(--line);border-radius:24rpx;padding:20rpx 18rpx;background:#fff}
.activity.selected{border-color:var(--accent);background:#f1f7f2}
.activity-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.choice{border:2rpx solid #d3d8e2;border-radius:50%;width:30rpx;height:30rpx;line-height:26rpx;text-align:center;font-size:21rpx;color:#fff}
.selected .choice{background:var(--accent);border-color:var(--accent)}
.activity-name{font-size:26rpx;font-weight:500;margin-bottom:3rpx}
.activity .muted{font-size:22rpx;display:block}
.points{display:block;font-size:22rpx;color:var(--accent);margin-top:2rpx}
.field-label{font-size:25rpx;margin:24rpx 0 12rpx}
.field-label text{color:var(--muted);font-size:22rpx;margin-left:10rpx}
.input{width:100%;height:86rpx;background:var(--soft);border:1rpx solid var(--line);border-radius:14rpx;padding:20rpx;font-size:24rpx}
.plan-summary{display:flex;justify-content:space-between;gap:12rpx;font-size:23rpx;color:var(--muted);margin-top:20rpx}
.plan-summary text+text{color:var(--accent)}
.rules{font-size:22rpx;line-height:1.8;color:var(--muted);margin-top:24rpx}
.journal-cover{display:flex;align-items:center;justify-content:space-between;background:var(--soft);border-radius:24rpx;margin-top:32rpx;padding:28rpx 32rpx}
.journal-label{font-size:22rpx;color:var(--muted)}
.journal-number{font-size:64rpx;line-height:1.4;font-family:Georgia,serif}
.journal-number text{font-size:24rpx;font-family:-apple-system,sans-serif;color:var(--muted);margin-left:20rpx}
.journal-icon{width:64rpx;height:64rpx;opacity:.7}
.board-banner{margin-top:32rpx}
.board-score{font-size:92rpx;line-height:1.4;font-family:Georgia,serif;padding:12rpx 0}
.board-score text{font-size:25rpx;font-family:-apple-system,sans-serif;margin-left:16rpx;color:#e7efe9}
.consent{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.consent>view{flex:1}
.consent .muted{font-size:23rpx}
.rank{display:flex;align-items:center;gap:26rpx;padding:26rpx 4rpx;border-bottom:1rpx solid var(--line)}
.rank-number{width:44rpx;font-size:34rpx;color:var(--accent)}
.rank-label{flex:1;font-size:28rpx}
.rank-label text{display:block;font-size:22rpx;color:var(--muted)}
.rank-points{font-size:34rpx}
.rank-points text{font-size:21rpx;color:var(--muted);margin-left:8rpx}
.empty{padding:55rpx 26rpx;text-align:center;background:var(--soft);border-radius:20rpx;margin-top:24rpx;font-size:27rpx;color:var(--ink)}
.empty>text{display:block;font-size:24rpx;color:var(--muted);margin-top:12rpx}
.empty button{margin:24rpx auto 0}
.empty.compact{padding:30rpx 20rpx;font-size:25rpx}
.demo-toggle{display:flex;justify-content:space-between;font-size:22rpx;color:var(--muted);border-top:1rpx solid var(--line);padding:24rpx 0;margin-top:40rpx}
.demo-tools{font-size:22rpx;color:var(--muted);background:var(--soft);padding:20rpx;border-radius:16rpx}
.demo-tools .actions{margin:0}
.demo-tools .text-button{font-size:22rpx}
.bottom-nav{position:fixed;z-index:20;bottom:0;left:0;right:0;display:flex;border-top:1rpx solid var(--line);background:rgba(255,255,255,.98);padding:16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom))}
.bottom-nav>view{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#737c8b;min-height:80rpx;font-size:22rpx;gap:6rpx}
.bottom-nav .nav-icon{width:40rpx;height:40rpx}
.bottom-nav .current{color:var(--accent);font-weight:600}
.error{background:#fff0ee;color:#a33b32;border-radius:12rpx;padding:20rpx;font-size:25rpx;margin:16rpx 0}
.overlay{position:fixed;z-index:100;inset:0;background:rgba(20,30,50,.45);display:flex;align-items:flex-end}
.sheet{width:100%;background:white;padding:36rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0}
.sheet textarea{width:100%;height:250rpx;background:var(--soft);border:1rpx solid var(--line);border-radius:16rpx;padding:24rpx;margin:24rpx 0;font-size:28rpx}
.sheet .muted{font-size:22rpx}


.together-card{overflow:hidden;min-height:330rpx}
.space-cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.cover-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,30,23,.6),rgba(8,30,23,.12));z-index:1}
.together-card>.card-top,.together-card>.day-count,.together-card>.card-bottom{position:relative;z-index:2}
.together-card .card-status{background:rgba(13,40,29,.5);border-color:rgba(255,255,255,.4);color:white}
.together-card .card-bottom{border-color:rgba(255,255,255,.3)}

/* Journal edition: restrained paper surfaces, editorial Chinese titles. */
page{--ink:#22382f;--muted:#6c786f;--line:#e7ebe5;--soft:#f3f5ef;background:#fafbf7}
.app{padding-top:18rpx}
.topline{margin-bottom:22rpx;font-size:22rpx;letter-spacing:0}
.home-kicker{font-size:18rpx;letter-spacing:4rpx;color:#687b67;margin-bottom:12rpx}
.editorial-title{font-family:'Songti SC','Noto Serif CJK SC',STSong,serif;font-weight:600;font-size:48rpx;letter-spacing:2rpx;line-height:1.45}
.home-heading{margin-bottom:24rpx}.home-heading .page-title{font-size:52rpx;margin-bottom:0}
.together-card{height:364rpx;min-height:0;border-radius:12rpx;padding:26rpx 28rpx}
.cover-index{font-size:18rpx;letter-spacing:3rpx;color:#f0f1d9}
.cover-title{position:relative;z-index:2;font-family:'Songti SC',STSong,serif;font-size:42rpx;font-weight:500;letter-spacing:4rpx;line-height:1.6;margin-top:24rpx}
.cover-bottom{position:absolute;z-index:2;left:28rpx;right:28rpx;bottom:24rpx;display:flex;justify-content:space-between;align-items:center;font-size:22rpx;color:#e5ecdf}
.cover-action{font-size:23rpx;background:#f5f3df;color:#243d30;padding:16rpx 22rpx;border-radius:8rpx;font-weight:500}
.cover-action text{font-size:26rpx;margin-left:12rpx}
.stats{padding:24rpx 0 22rpx;margin-bottom:22rpx;background:#f0f3ec;border:0;border-radius:0 0 12rpx 12rpx}
.stats .number{font-family:Georgia,serif;font-size:40rpx;font-weight:400}.stats>view{font-size:21rpx;border-color:#dce4d7}
.section-heading{font-size:29rpx;margin:26rpx 0 16rpx}
.quick-plans{gap:12rpx}.quick-plans>view{background:#fff;border-radius:12rpx;border-color:#e4e9df;padding:22rpx 10rpx}.quick-plans .plan-icon{width:40rpx;height:40rpx;margin-bottom:12rpx}.quick-plans>view>text{font-size:19rpx}
.week-strip{margin-top:28rpx;padding:6rpx 0 24rpx;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line)}
.week-strip .section-heading{margin:16rpx 0 20rpx;font-size:27rpx}.week-summary{font-size:21rpx;font-weight:400;color:var(--muted)}
.week-days{display:flex;justify-content:space-between}.week-day{display:flex;align-items:center;flex-direction:column;gap:12rpx;color:var(--muted);font-size:20rpx;width:70rpx}.day-dot{width:56rpx;height:56rpx;border-radius:50%;background:#eff2eb;text-align:center;line-height:56rpx;font-size:22rpx;color:#64765e}.day-dot.done{background:#276653;color:white}.is-today>text{color:#276653;font-weight:600}.is-today .day-dot{outline:2rpx solid #95ad8b;outline-offset:5rpx}
.activity-grid{margin-top:26rpx;gap:12rpx}.activity{border-radius:14rpx;padding:18rpx 16rpx;background:#fff}.activity-top{margin-bottom:12rpx}.activity .plan-icon{width:38rpx;height:38rpx}.activity-name{font-size:25rpx}.activity .muted,.points{font-size:21rpx}.activity.selected{background:#eaf1e7;border-color:#537947}
.plan-detail{border-radius:16rpx;background:white;padding:26rpx;margin-top:22rpx}.detail-kicker{font-size:20rpx;color:#6e8067;letter-spacing:2rpx;margin-bottom:12rpx}.plan-detail .section-title{font-size:32rpx}
.idea-box{margin-top:22rpx;background:#f4f0df;border-radius:4rpx;padding:20rpx 22rpx;border-left:4rpx solid #b7ac74}.idea-heading{display:flex;align-items:center;justify-content:space-between;color:#726b48;font-size:21rpx}.idea-refresh{font-size:21rpx;color:#726b48;padding:8rpx 0 8rpx 18rpx}.idea-copy{font-size:26rpx;color:#4f513b;line-height:1.7;margin-top:10rpx}.idea-use{font-size:22rpx;color:#52664a;text-align:right;margin-top:8rpx;padding:10rpx 0 4rpx;min-height:48rpx}
.primary{border-radius:12rpx;padding:23rpx 20rpx}.input{background:#fafbf7;border-radius:10rpx}.panel{border-radius:16rpx}.active-panel{border-left:5rpx solid #276653}
.journal-cover{margin-top:26rpx;border-radius:0;background:none;padding:20rpx 0 22rpx;border-bottom:1rpx solid #dce4d7}.journal-number{font-size:72rpx}.journal-number text{font-size:23rpx;margin-left:18rpx}.journal-seal{border:1rpx solid #96a58c;color:#617851;padding:9rpx 13rpx;letter-spacing:2rpx;font-size:20rpx;transform:rotate(-5deg)}
.memory-filters{display:block;width:100%;overflow-x:auto;white-space:nowrap;margin:24rpx 0 30rpx}.filter-row{display:flex;gap:12rpx;width:max-content;padding:2rpx}.filter-chip{display:inline-block;flex-shrink:0;font-size:23rpx;color:var(--muted);padding:15rpx 23rpx;line-height:1.4;border:1rpx solid #e4e9df;border-radius:30rpx;background:#fff}.filter-chip.chosen{background:#276653;color:#fff;border-color:#276653}
.timeline-entry{display:flex;gap:22rpx;margin-bottom:26rpx}.timeline-date{width:64rpx;flex-shrink:0;padding-top:14rpx;text-align:center;color:var(--muted)}.timeline-date>text{display:block;font-size:20rpx}.timeline-date>text:first-child{font-family:Georgia,serif;font-size:43rpx;color:#304f3c;line-height:1.3}.timeline-paper{flex:1;min-width:0;background:white;border:1rpx solid #e6eade;border-radius:4rpx 16rpx 16rpx 16rpx;padding:24rpx;box-shadow:0 6rpx 18rpx rgba(33,57,32,.025)}.timeline-paper .memory-title{font-size:27rpx}.memory-title>view{display:flex;gap:12rpx;align-items:center}.memory-icon{width:30rpx;height:30rpx}.timeline-paper .note{font-family:'Songti SC',STSong,serif;font-size:29rpx;line-height:1.9;margin:24rpx 0;padding:12rpx 0 18rpx;border-bottom:1rpx solid var(--line)}.note.unwritten{font-size:26rpx;color:#899381;font-style:italic}.timeline-paper .memory-footer{margin-top:4rpx}.timeline-paper .location{font-size:22rpx;margin-top:12rpx}.timeline-paper .link{font-size:22rpx}
.bottom-nav{background:#fafbf7;padding-top:12rpx}.bottom-nav>view{gap:4rpx;min-height:76rpx}.bottom-nav .nav-icon{width:38rpx;height:38rpx}.bottom-nav .current text{position:relative}.bottom-nav .current text::after{content:'';display:block;height:3rpx;background:#276653;border-radius:3rpx;margin-top:3rpx}
@media(max-width:350px){.app{padding-left:28rpx;padding-right:28rpx}.editorial-title{font-size:44rpx}.quick-plans>view>text{font-size:18rpx}.plan-summary{font-size:21rpx}.timeline-entry{gap:14rpx}.timeline-paper{padding:20rpx}}

.cover-action,.filter-chip,.idea-refresh,.idea-use,.memory-footer .link{width:auto!important;max-width:none!important;margin-left:0;margin-right:0}
.idea-use{margin-left:auto}.filter-chip{min-width:88rpx}.cover-action{flex-shrink:0}
.with-dock{padding-bottom:340rpx}
.activity-dock{position:fixed;z-index:19;bottom:calc(108rpx + env(safe-area-inset-bottom));left:0;right:0;display:flex;gap:24rpx;align-items:center;padding:20rpx 36rpx;background:#fafbf7;border-top:1rpx solid #e0e7db;box-shadow:0 -8rpx 25rpx rgba(29,53,35,.035)}
.activity-dock>view{flex:1;min-width:0}.activity-dock>view>text{display:block;font-size:26rpx}.activity-dock>view>text+text{font-size:21rpx;color:var(--muted);margin-top:4rpx}.activity-dock .primary{width:330rpx!important;flex-shrink:0;margin:0;padding:22rpx 12rpx}
/* Leaderboard is the product entry point. */
.board-heading{padding:8rpx 0 22rpx}.board-heading .editorial-title{font-size:58rpx;letter-spacing:3rpx}.season-line{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid var(--line);padding:20rpx 0;font-size:24rpx}.season-line>text+text{font-size:21rpx;color:var(--muted)}
.ranking-card{background:#213e32;border-radius:18rpx;padding:28rpx;color:#fff}.ranking-top{display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#e2e9d9}.ranking-badge{font-size:20rpx;padding:5rpx 14rpx;border:1rpx solid #69816c;border-radius:24rpx;color:#e2e6bf}.ranking-numbers{display:flex;margin:28rpx 0 20rpx}.ranking-numbers>view{width:50%;display:flex;flex-direction:column;gap:8rpx;font-size:22rpx;color:#c4d3c0}.ranking-numbers>view+view{border-left:1rpx solid #526959;padding-left:30rpx}.ranking-value{font-family:Georgia,serif;font-size:88rpx;line-height:1.1;color:#f4edc8}.ranking-value.rank-value{color:white;font-size:74rpx;line-height:1.3}.rank-target{border-top:1rpx solid #526959;padding-top:20rpx;font-size:23rpx;line-height:1.65;color:#dde6d4}.rank-cta{width:100%!important;max-width:none!important;margin:22rpx 0 0;background:#e6eacb;color:#233e2f;font-size:26rpx;font-weight:500;padding:23rpx 12rpx;border-radius:10rpx}.leaderboard{background:white;border:1rpx solid var(--line);border-radius:16rpx;overflow:hidden}.leaderboard-head{display:flex;justify-content:space-between;padding:20rpx 24rpx;background:#f0f3e9;font-size:22rpx;color:var(--muted)}.leaderboard .rank{margin:0;padding:24rpx;gap:20rpx}.leaderboard .rank:last-child{border-bottom:0}.rank-number{font-family:Georgia,serif;color:#71806c}.rank-number.top-rank{color:#8a6d2d;font-weight:600}.our-rank{background:#f1f7ed}.board-empty{text-align:center;padding:38rpx 20rpx;font-size:26rpx}.board-empty>text{display:block;font-size:22rpx;line-height:1.8;color:var(--muted);margin-top:8rpx}.empty-rank-icon{width:50rpx;height:50rpx;margin:0 auto 20rpx;opacity:.65}.score-breakdown{background:white;border:1rpx solid var(--line);border-radius:16rpx;padding:0 24rpx}.score-row{display:flex;gap:18rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid var(--line)}.score-row:last-child{border-bottom:0}.score-row>view{flex:1;font-size:25rpx}.score-row>view>text{display:block;font-size:21rpx;color:var(--muted);margin-top:4rpx}.earned{font-size:32rpx;color:var(--accent);font-family:Georgia,serif}.earned>text{font-size:21rpx;font-family:-apple-system,sans-serif}.board-fairness{margin-top:30rpx;padding:24rpx;background:#f0f2e8;border-radius:12rpx}.board-fairness>text{display:block;color:var(--muted);font-size:22rpx;line-height:1.85;margin-top:12rpx}

/* Lakeside club: photographic cover, overlapping score ticket, editorial ranking. */
.board-masthead{display:flex;align-items:center;justify-content:space-between;margin:4rpx 0 24rpx}.masthead-mark{font-family:'Songti SC',STSong,serif;font-size:34rpx;font-weight:600;letter-spacing:3rpx;display:block}.masthead-sub{display:block;color:var(--muted);font-size:20rpx;letter-spacing:2rpx;margin-top:2rpx}.board-masthead .couple text{width:54rpx;height:54rpx;line-height:46rpx;font-size:20rpx;background:#e5eddf}.board-masthead .couple text+text{background:#ece6d8;color:#7b6d4c}
