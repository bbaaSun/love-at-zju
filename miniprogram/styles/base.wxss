.couple-board .ranking-section-title{font-size:34rpx}.couple-board .ranking-section-heading{margin-top:30rpx}.couple-board .leaderboard{background:transparent;border:0;border-radius:0}.couple-board .leaderboard-head{padding:12rpx 16rpx;background:transparent;color:#6c7867;font-size:20rpx;border-bottom:1rpx solid #dfe4d6}.couple-board .rank{padding:22rpx 14rpx;gap:18rpx;border-bottom:1rpx solid #e5e8dd;min-height:112rpx}.couple-board .rank-number{width:42rpx;font-size:36rpx;color:#89917e}.couple-board .rank-emblem{width:60rpx;height:60rpx;border:0;background:#e7ecdf;color:#738065;font-size:24rpx}.couple-board .rank-label{font-size:27rpx;color:#2c4334;font-weight:500}.couple-board .rank-label>text{font-size:19rpx;font-weight:400;color:#78816f;margin-top:4rpx}.couple-board .rank-points{font-size:43rpx;line-height:1.2;color:#304937}.couple-board .rank-points>text{font-size:18rpx}.couple-board .rank-tier-1 .rank-number{color:#9b772e}.couple-board .rank-tier-1 .rank-emblem{background:#e8d6a6;color:#735e31;box-shadow:0 0 0 4rpx #f4ecdb}.couple-board .rank-tier-2 .rank-emblem{background:#dce3dd;color:#5a7063}.couple-board .rank-tier-3 .rank-emblem{background:#e9ddcf;color:#856d4c}.couple-board .our-rank{background:#e7efdf;border-radius:12rpx;border:1rpx solid #cddbc0;margin-top:8rpx}.couple-board .our-rank .rank-label>text{color:#356044;font-weight:500}
