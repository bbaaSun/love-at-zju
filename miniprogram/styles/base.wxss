.podium-score{display:flex;align-items:baseline;justify-content:center;gap:7rpx}.podium-score>text:first-child{font-family:Georgia,serif;font-size:45rpx;color:#f0dfae}.podium-slot-0 .podium-score>text:first-child{font-size:58rpx}.podium-score .podium-unit{font-family:-apple-system,sans-serif;font-size:17rpx;color:#c5cfb9}.club-heading>button{margin:0}

/* v0.11: fewer labels; motion communicates entry, touch and earned points. */
.honour-heading{align-items:center;padding:30rpx 26rpx 0}.honour-heading>view>view{font-size:56rpx}.honour-week>text:first-child{border:0;padding:0;font-size:20rpx;font-weight:400;color:#dce5d2}.podium{padding-top:20rpx}.podium-plinth{justify-content:center;padding:12rpx 0;height:54rpx}.podium-slot-0 .podium-plinth{height:72rpx}.podium-slot-2 .podium-plinth{height:46rpx}.podium-plinth>text:first-child{font-size:21rpx;font-weight:500}.honour-stage{padding-bottom:0}.position-top{padding:18rpx 24rpx}.position-rank>text{font-size:56rpx}.position-rank>view{font-size:26rpx}.position-bottom{padding:8rpx 20rpx}.couple-board .ranking-section-heading{margin-top:30rpx}.ranking-rule-link{width:auto!important;max-width:none!important;margin:0;min-height:64rpx;display:flex;align-items:center;padding:10rpx 0 10rpx 24rpx;font-size:24rpx;color:#526b50}.couple-board .rank{min-height:100rpx;padding:20rpx 14rpx}.couple-board .rank-label>text{margin-top:3rpx;font-size:20rpx}.couple-board .rank-points .rank-score-number{font-size:46rpx}
@keyframes podium-arrive{from{opacity:0;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes row-arrive{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes points-earned-a{0%,100%{transform:scale(1)}35%{transform:scale(1.16);color:#a67c29}}
@keyframes points-earned-b{0%,100%{transform:scale(1)}35%{transform:scale(1.16);color:#a67c29}}
.podium-person{animation:podium-arrive 550ms cubic-bezier(.2,.8,.2,1) both}.podium-slot-0{animation-delay:40ms}.podium-slot-1{animation-delay:130ms}.podium-slot-2{animation-delay:210ms}.couple-board .rank{animation:row-arrive 380ms ease-out both;transition:background-color 140ms ease-out}.podium-avatar{transition:transform 140ms ease-out}.podium-pressed .podium-avatar{transform:scale(.92)}.couple-board .rank-pressed{background:#dde8d5}.position-bottom>button{transition:opacity 140ms ease-out}.position-bottom>button:active{opacity:.65}.score-up-a .position-points>text:first-child{animation:points-earned-a 650ms ease-out}.score-up-b .position-points>text:first-child{animation:points-earned-b 650ms ease-out}
@media(prefers-reduced-motion:reduce){.podium-person,.couple-board .rank,.score-up-a .position-points>text:first-child,.score-up-b .position-points>text:first-child{animation:none}.podium-avatar,.couple-board .rank,.position-bottom>button{transition:none}.podium-pressed .podium-avatar{transform:none}}
@media(max-width:350px){.honour-heading>view>view{font-size:48rpx}.honour-week>text:first-child{font-size:18rpx}}


