/* v0.17: one family, different page rhythms. */
page{background:#fff;--ink:#243b31;--muted:#788078;--line:#ebeee8;--soft:#f7f8f4}
.app{padding-top:22rpx}.topline{margin-bottom:20rpx}.page-activities>.topline,.page-journal>.topline,.page-home>.topline,.page-pair>.topline{display:none}
.bottom-nav{background:rgba(255,255,255,.97);border-top:1rpx solid #edf0ea;box-shadow:none}.panel,.plan-detail,.timeline-paper,.position-card,.comparison-card{box-shadow:none}
.page-activities .page-title{font-family:var(--font-body);font-size:40rpx;font-weight:500;letter-spacing:-1rpx;margin:22rpx 0 32rpx}
.activity-grid{gap:12rpx 8rpx;margin:0}.activity{border:0;border-radius:0;background:transparent;padding:24rpx 8rpx 18rpx;text-align:center;min-height:140rpx;box-sizing:border-box}.activity.selected{background:transparent;border:0}.activity-top{justify-content:center;position:relative;margin-bottom:14rpx}.activity .plan-icon{width:48rpx;height:48rpx;padding:18rpx;border-radius:50%;background:#f6f7f2;transition:transform 180ms,background 180ms}.activity.selected .plan-icon{background:#e3eddc;transform:translateY(-3rpx)}.activity .choice{display:none}.activity-name{font-size:25rpx}.activity .muted{display:none}.activity .points{display:block;position:static;font-size:20rpx;color:#71806c;margin-top:3rpx}.activity.selected .activity-name{color:#244e3b}.activity.selected::after{content:'';display:block;width:20rpx;height:3rpx;background:#56744a;margin:10rpx auto 0}
.plan-detail{padding:24rpx 0 0;background:none;border:0;margin:22rpx 0 0;border-radius:0}.plan-prompt{font-size:27rpx;color:#52654e}.idea-box{background:#f7f8f3;border:0;border-radius:14rpx;padding:20rpx 24rpx;margin:18rpx 0 26rpx}.idea-heading{font-size:20rpx;color:#7a8372}.idea-copy{font-size:25rpx;margin:2rpx 0;line-height:1.65}.idea-use{min-height:60rpx;padding-top:8rpx;margin-top:0}.field-label{margin:24rpx 0 12rpx;font-size:23rpx}.page-activities .input{border:0;border-bottom:1rpx solid #dbe2d5;border-radius:0;background:none;padding:12rpx 0;height:74rpx;box-sizing:border-box;font-size:25rpx}.date-rules{font-size:20rpx!important;color:#7b8278!important;margin-top:20rpx!important;min-height:64rpx}.activity-dock{box-shadow:none;border-top:1rpx solid #e8ece3;background:#fff}.date-session{background:none;border:0;padding:0;margin-top:0}.date-session-name{font-size:30rpx;margin:24rpx 0 0}.date-session-time{margin:24rpx auto;padding:64rpx 20rpx;border-radius:50%;width:330rpx;height:330rpx;box-sizing:border-box;background:#f2f5e9;display:flex;flex-direction:column;justify-content:center}.date-session-time>text{font-size:50rpx}.date-members{border-top:0}
/* A private shared home, without another promotional cover. */
.space-heading{display:flex;align-items:center;justify-content:space-between;padding:12rpx 0;font-size:24rpx;color:#71816f}.space-heading .settings-link{width:auto!important;margin:0!important;min-height:70rpx;padding:10rpx 0 10rpx 24rpx}.space-intimacy{text-align:center;padding:38rpx 0 42rpx}.space-names{display:flex;justify-content:center;align-items:center;gap:24rpx;font-size:27rpx}.space-names>text{max-width:250rpx;overflow-wrap:anywhere}.space-heart{color:#a66b68;font-size:40rpx}.space-days{font-family:Georgia,serif;font-size:130rpx;line-height:1.3;margin:12rpx 0 8rpx;font-weight:400;letter-spacing:-5rpx}.space-days>text{font-family:var(--font-body);font-size:23rpx;margin-left:14rpx;letter-spacing:0;color:#79816f}.space-caption{font-family:var(--font-title);font-size:25rpx;color:#7b806f}.space-links{display:flex;justify-content:center;border-top:1rpx solid #e8ebe2;padding:24rpx 0;margin:0 0 12rpx}.space-links>view{flex:1;text-align:center}.space-links>view+view{border-left:1rpx solid #e8ebe2}.space-links text{display:block;font-size:22rpx;color:#7b8276}.space-links text:first-child{font-family:Georgia,serif;font-size:34rpx;color:#314735}.space-date{background:#edf2e5!important;color:#36583b!important;margin-bottom:32rpx}.page-home .week-strip{background:none;border:0;padding:0}.page-home .memory{border:0;border-top:1rpx solid #edf0e7;border-radius:0;background:none;padding:22rpx 0;margin:0}
/* Memories use a continuous timeline rather than a stack of boxed panels. */
.page-journal{background:#fcfaf5;min-height:100vh;box-sizing:border-box}.journal-heading{padding:32rpx 0 30rpx}.journal-heading .page-title{margin-bottom:8rpx;font-size:44rpx}.journal-heading>text{font-size:21rpx;color:#898273}.memory-filters{margin-bottom:32rpx}.filter-chip{border:0!important;background:none!important;color:#8a8478!important;border-radius:0;padding:14rpx 16rpx}.filter-chip.chosen{color:#324d36!important;box-shadow:inset 0 -2rpx #46684c}.timeline-entry{gap:22rpx;margin-bottom:0}.timeline-date{padding-top:22rpx;width:58rpx}.timeline-paper{background:none;border:0;border-left:1rpx solid #e2e0d5;border-radius:0;padding:22rpx 0 30rpx 24rpx;box-shadow:none}.timeline-paper .memory-title{font-weight:400;font-size:26rpx}.timeline-paper .note{border:0;padding:0;margin:18rpx 0;font-family:var(--font-title);font-size:29rpx}.timeline-paper .note.unwritten{font-family:var(--font-body);font-size:23rpx}.timeline-paper .memory-title>text{font-size:20rpx;color:#8a8e7e}.memory-footer{color:#929185;font-size:20rpx}.page-journal .empty{background:none;border:0;padding:76rpx 12rpx}
/* The public board alone retains its photographic stage. */
.honour-stage{border-radius:16rpx}.honour-heading>view>view{font-size:40rpx}.honour-waiting{font-size:28rpx!important;padding:42rpx 28rpx!important;min-height:0!important}.position-card{border:0!important;border-radius:0!important;background:none!important;margin-top:16rpx}.position-top{padding:18rpx 0}.position-bottom{background:#f3f6ee!important;color:#52664a!important;border-radius:10rpx;padding:10rpx 16rpx}.position-bottom>button{color:#365c3f!important}.position-rank>text{font-size:38rpx}.podium-avatar{box-shadow:none!important}.podium-plinth{background:none!important;border:0!important;height:36rpx!important}.podium-honour{display:none}.podium-person{padding-top:20rpx}.couple-board .rank-emblem{display:none}.couple-board .rank{border-radius:0;min-height:96rpx;padding:18rpx 4rpx}.couple-board .rank-number{width:60rpx}.couple-board .our-rank{background:#f0f5e9}.season-entry{border:0!important;background:none!important;border-top:1rpx solid #e8ebe2!important;border-radius:0!important;padding:24rpx 0!important;margin-top:26rpx}.season-entry-mark{background:#f1f2e9!important}.consent{border:0!important;background:none!important;padding:22rpx 0!important;margin-top:0}.couple-board .board-empty{padding:36rpx 16rpx}.couple-board .empty-rank-icon{display:none}
/* Joining feels like an invitation, not another landing page. */
.pair-intro{text-align:center;padding:36rpx 0 24rpx}.pair-intro>view+view{font-family:var(--font-title);font-size:36rpx;margin-top:26rpx}.pair-symbol{display:flex;justify-content:center;padding:6rpx}.pair-symbol>text{width:100rpx;height:100rpx;border-radius:50%;background:#eef1e3;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:#617353;border:4rpx solid #fff}.pair-symbol>text+text{margin-left:-18rpx;background:#f3eae2;color:#916e5b}.pair-paper{padding:26rpx 0}.pair-paper .section-title{font-size:26rpx}.pair-paper>.muted{font-size:22rpx;margin-bottom:18rpx}.pair-code{font-size:32rpx;padding:14rpx 0}.pair-wait{font-size:22rpx;padding-top:12rpx}.pair-wait>text{display:none}.pair-accept .section-title{font-size:24rpx}.pair-accept>.muted{display:none}
.profile-cover{background:#f3f5eb!important;color:#314b37!important;height:auto!important;min-height:0!important;padding:30rpx!important;border-radius:12rpx}.profile-copy{position:static!important;color:#314b37!important}.profile-copy>view{font-size:32rpx}.profile-seal{color:#6d8061!important;border:0!important;padding:0!important}.comparison-card{background:none!important;border:0!important;padding:24rpx 0!important}.reward-card{box-shadow:none;border-radius:12rpx}.settings-section{padding:26rpx 0}.page-settings .page-title,.page-privacy .page-title,.page-rules .page-title{font-family:var(--font-body);font-size:34rpx}.flow-back{min-height:64rpx;margin-bottom:16rpx}
@media(prefers-reduced-motion:reduce){.activity .plan-icon{transition:none}}

.app>.topline.demo-topline{display:flex;font-size:19rpx;margin-bottom:10rpx}.space-days{overflow-wrap:anywhere}.page-home .empty{background:none;border-top:1rpx solid #edf0e7;border-radius:0}
