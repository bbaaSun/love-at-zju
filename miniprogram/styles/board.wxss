/* The public weekly board is the visual centre; other tabs stay quiet. */
.page-board{background:#f8f6ee;min-height:100vh;box-sizing:border-box}.page-board>.topline{color:#677266}.page-board .honour-stage{border-radius:22rpx;background:#153c32;isolation:isolate}.page-board .honour-photo{height:660rpx;opacity:.82}.page-board .honour-shade{height:100%;background:linear-gradient(180deg,rgba(13,42,31,.28),rgba(20,52,39,.48) 30%,#153c32 78%)}
.honour-edition{position:relative;display:flex;justify-content:space-between;gap:12rpx;padding:26rpx 28rpx 0;font-size:18rpx;color:#e1e5cc;letter-spacing:1rpx}.page-board .honour-heading{padding:24rpx 28rpx 16rpx;align-items:flex-start;justify-content:space-between}.page-board .honour-heading>view>view{font-size:52rpx;letter-spacing:3rpx;margin:0;line-height:1.45;font-weight:400}.page-board .honour-description{font-size:22rpx;color:#f0ead5;margin-top:8rpx}.honour-seal{border:1rpx solid #d1b97c;width:54rpx;height:76rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;font-family:var(--font-title);font-size:24rpx;color:#f0d697;line-height:1.3;transform:rotate(5deg)}.honour-orbit{position:absolute;width:550rpx;height:330rpx;border:1rpx solid rgba(218,197,141,.18);border-radius:50%;left:50%;top:205rpx;transform:translateX(-50%) rotate(-13deg);pointer-events:none}
.page-board .podium{padding:18rpx 18rpx 0;gap:12rpx;align-items:flex-end}.page-board .podium-person{padding-top:26rpx}.page-board .podium-honour{display:block;visibility:visible;color:#b9c8b6;font-size:18rpx;letter-spacing:1rpx;margin-bottom:18rpx}.page-board .podium-slot-0 .podium-honour{color:#edd391}.page-board .podium-avatar{width:78rpx;height:78rpx;border:1rpx solid #b3c1af;background:rgba(118,145,119,.28);font-size:48rpx;font-family:Georgia,serif;margin-bottom:20rpx}.page-board .podium-slot-0 .podium-avatar{width:104rpx;height:104rpx;background:linear-gradient(135deg,#f1deaa,#bba36a);color:#254635;border:6rpx double #fff0c5;font-size:58rpx;box-shadow:0 0 32rpx rgba(231,203,141,.17)!important}.page-board .podium-medal{font-size:19rpx;line-height:30rpx;background:#dae2d3;color:#304e3b}.page-board .podium-slot-0 .podium-medal{background:#ecd299}.page-board .podium-name{font-size:22rpx;font-weight:400;color:#f0eee0}.page-board .podium-score{margin:8rpx 0 22rpx}.page-board .podium-score>text:first-child{font-size:46rpx;color:#ede3c7}.page-board .podium-slot-0 .podium-score>text:first-child{font-size:68rpx;color:#f9dda0}.page-board .podium-plinth{height:62rpx!important;background:linear-gradient(180deg,rgba(126,154,125,.3),rgba(70,106,79,.04))!important;border-top:1rpx solid #7f9a7e!important;border-radius:8rpx 8rpx 0 0}.page-board .podium-slot-0 .podium-plinth{height:88rpx!important;border-top-color:#d7ba7a!important;background:linear-gradient(180deg,rgba(214,187,122,.33),rgba(126,131,80,.04))!important}.page-board .podium-slot-2 .podium-plinth{height:46rpx!important}.page-board .podium-plinth>text{font-size:20rpx;letter-spacing:2rpx;color:#e7e4cb}
.honour-footer{position:relative;display:flex;justify-content:space-between;gap:12rpx;border-top:1rpx solid rgba(205,219,183,.2);margin:0 24rpx;padding:19rpx 0;font-size:18rpx;color:#c4d0bc}.page-board .honour-waiting{text-align:center;padding:22rpx 24rpx 40rpx!important;min-height:260rpx!important;font-family:var(--font-title);font-size:28rpx!important}.honour-waiting>text{display:block;font-family:var(--font-body);font-size:20rpx;color:#c5d0bb;margin-top:10rpx}.vacant-medal{margin:8rpx auto 24rpx;width:110rpx;height:110rpx;line-height:104rpx;border:6rpx double #cabd86;border-radius:50%;font-family:Georgia,serif;font-size:68rpx;color:#e5cf92;background:rgba(225,211,152,.1)}
.page-board .position-card{background:#fffdf8!important;border:1rpx solid #e8e3d4!important;border-radius:14rpx!important;margin:20rpx 0 0;box-shadow:0 8rpx 24rpx rgba(58,65,39,.035)}.page-board .position-top{padding:24rpx}.page-board .position-rank>text{font-size:48rpx}.page-board .position-rank>view{font-size:23rpx}.page-board .position-rank>view>text{font-size:19rpx}.page-board .position-points{display:flex;flex-direction:column;gap:0;align-items:flex-end}.page-board .position-points>text:first-child{font-size:44rpx}.page-board .position-points>text+text{font-size:18rpx}.page-board .position-bottom{background:#e9eedf!important;border-radius:0;padding:8rpx 24rpx}.page-board .position-bottom>text{font-size:21rpx}.page-board .ranking-section-heading{margin-top:38rpx;margin-bottom:10rpx}.page-board .ranking-section-title{font-family:var(--font-title);font-size:32rpx;font-weight:400}.ranking-section-title>text{display:block;font-family:var(--font-body);font-size:15rpx;letter-spacing:3rpx;color:#8a8c78;margin-top:2rpx}.page-board .leaderboard-head{padding:12rpx 12rpx;color:#7b816e;font-size:19rpx}.page-board .rank{padding:22rpx 12rpx;gap:18rpx;min-height:106rpx}.page-board .rank-number{width:46rpx;font-size:32rpx;color:#858d78}.page-board .rank-tier-1{background:#f2ead5}.page-board .rank-tier-2{background:#eeeee3}.page-board .rank-tier-3{background:#f3ece1}.page-board .rank-tier-1,.page-board .rank-tier-2,.page-board .rank-tier-3{border-radius:8rpx;margin-top:6rpx;border-bottom:0}.page-board .rank-tier-1 .rank-number{color:#927039;font-size:38rpx}.page-board .rank-name{font-size:25rpx}.page-board .rank-points .rank-score-number{font-size:42rpx}.page-board .rank-label{min-width:0}.rank-meter{height:4rpx;width:100%;max-width:270rpx;margin-top:13rpx;background:rgba(124,144,106,.1);border-radius:4rpx;overflow:hidden}.rank-meter>view{height:100%;background:#99ab85;transition:width .6s ease}.rank-tier-1 .rank-meter>view{background:#b6995c}.page-board .our-rank{box-shadow:inset 4rpx 0 #527047;background:#e5ecd9;border:0;border-radius:8rpx}.page-board .season-entry{background:#ede7d7!important;border:1rpx solid #dfd6bc!important;border-radius:12rpx!important;padding:25rpx 22rpx!important}.page-board .season-entry-mark{background:none!important;border-radius:50%;width:68rpx;height:68rpx;font-size:44rpx;transform:none}.page-board .season-entry>view>text{font-family:var(--font-title);font-size:29rpx;font-weight:400}.page-board .season-entry>view>text+text{font-family:var(--font-body);font-size:20rpx}.page-board .consent .section-title{font-size:24rpx}.page-board .consent .muted{font-size:20rpx}
@media(prefers-reduced-motion:reduce){.rank-meter>view{transition:none}}
