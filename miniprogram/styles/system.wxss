/* Shared across every page, state and dialog. Layout and whitespace carry hierarchy. */
page{--font-body:-apple-system,BlinkMacSystemFont,'PingFang SC','Helvetica Neue',sans-serif;--font-title:'Songti SC',STSong,serif;--font-number:Georgia,'Times New Roman',serif;--text-title:42rpx;--text-section:29rpx;--text-body:26rpx;--text-meta:22rpx;--ink:#283b31;--muted:#6d796e;--line:#e2e7dd;--soft:#f0f3eb;font-family:var(--font-body);font-size:var(--text-body);font-weight:400;line-height:1.65;background:#fafbf7}
button,input,textarea{font-family:var(--font-body);font-weight:400;letter-spacing:0}
.page-title,.editorial-title,.home-heading .page-title,.flow-page .editorial-title{font-family:var(--font-title);font-size:var(--text-title);font-weight:400;line-height:1.4;letter-spacing:1rpx;margin:0 0 24rpx}
.home-heading{margin-bottom:22rpx}.home-heading .page-title{margin-bottom:0}
.section-heading,.section-title,.section-title.small,.plan-detail .section-title,.week-strip .section-heading{font-family:var(--font-body);font-size:var(--text-section);font-weight:500;letter-spacing:0;line-height:1.5}
.section-heading{margin:36rpx 0 18rpx}.section-heading .link,.section-heading .week-summary{font-weight:400}
.muted,.flow-note,.rules,.privacy-note text{font-size:var(--text-meta);font-weight:400;line-height:1.8;color:var(--muted)}
.topline{font-size:20rpx;margin-bottom:24rpx;color:var(--muted)}.mode-tag{font-size:20rpx;background:none;padding:0}.link,.text-button,.flow-back{font-size:24rpx;font-weight:400}.flow-back{margin-bottom:20rpx;min-height:72rpx}
.primary,.secondary,.reward-secondary,.poster-actions button{font-size:26rpx;font-weight:500;border-radius:10rpx;line-height:1.5}.primary{padding:24rpx 20rpx}.primary,.secondary,.text-button,.cover-action,.filter-chip,.idea-use,.idea-refresh{transition:opacity 140ms ease,background-color 140ms ease}.primary:active,.secondary:active,.text-button:active{opacity:.72}
.bottom-nav>view{font-size:22rpx;font-weight:400}.bottom-nav .current{font-weight:500}.bottom-nav .current text::after{height:2rpx}
/* Our space: one photographic headline, quiet metrics and useful actions. */
.cover-title{font-size:38rpx;font-weight:400;letter-spacing:2rpx;line-height:1.6;margin-top:28rpx}.together-card{height:320rpx;padding:24rpx}.card-top{justify-content:flex-end}.card-status{font-size:21rpx;font-weight:400;border:0!important;background:none!important;padding:0}.cover-bottom{justify-content:flex-end;left:24rpx;right:24rpx}.cover-action{font-size:24rpx;font-weight:400;padding:15rpx 20rpx}.stats .number{font-family:var(--font-number);font-size:40rpx;font-weight:400}.stats>view{font-size:var(--text-meta)}.quick-plans>view>view{font-size:26rpx;font-weight:400}.quick-plans>view>text{font-size:20rpx}.week-summary{font-size:22rpx}.is-today>text{font-weight:500}.panel{padding:26rpx;border-radius:14rpx}.eyebrow{font-size:21rpx;font-weight:400;letter-spacing:0}.activity-info{font-size:25rpx}.memory-title{font-size:28rpx;font-weight:500}.memory-title>text{font-size:24rpx;font-weight:400}
/* Activity planning: selection, not type weight, marks the current choice. */
.activity{padding:24rpx 16rpx;transition:background-color 160ms ease,border-color 160ms ease}.activity.selected{background:#edf3e8;border-color:#78906e}.activity-name{font-size:25rpx;font-weight:400}.activity .muted,.points{font-size:21rpx;font-weight:400}.activity-top{margin-bottom:18rpx}.plan-detail{padding:28rpx;margin-top:28rpx;border-radius:14rpx}.plan-detail>.muted{font-size:23rpx}.idea-box{padding:20rpx;margin-top:24rpx;background:#f5f2e6;border-left:2rpx solid #b9b08d}.idea-heading{font-size:22rpx}.idea-copy{font-size:26rpx;line-height:1.85;font-weight:400}.idea-use,.idea-refresh{font-size:23rpx;min-height:64rpx}.field-label{font-size:24rpx}.plan-summary{font-size:22rpx}.activity-dock>view>text{font-size:26rpx;font-weight:400}.activity-dock>view>text+text{font-size:22rpx}.activity-dock .primary{font-weight:500}
/* Memories: the user's words are the main content. */
.journal-cover{margin-top:0;padding:4rpx 0 24rpx}.journal-number{font-family:var(--font-number);font-size:48rpx;font-weight:400}.journal-number text{font-size:22rpx}.journal-private{font-size:22rpx;color:var(--muted)}.filter-chip{font-size:23rpx;font-weight:400;padding:14rpx 22rpx}.timeline-date>text:first-child{font-size:36rpx;font-weight:400}.timeline-date>text{font-size:20rpx}.timeline-paper .memory-title{font-size:27rpx;font-weight:500}.timeline-paper .note{font-family:var(--font-body);font-size:26rpx;font-weight:400;line-height:1.9;margin:18rpx 0;padding:4rpx 0 18rpx}.timeline-paper .note.unwritten{font-size:24rpx;font-style:normal}.memory-footer{font-size:21rpx}.timeline-paper .link{font-size:23rpx}
/* Public board: retain the stage silhouette; restore restrained lettering. */
.honour-heading>view>view{font-family:var(--font-title);font-size:46rpx;font-weight:400;letter-spacing:2rpx;line-height:1.35}.honour-week>text:first-child{font-size:20rpx;font-weight:400}.podium-honour{font-size:19rpx;font-weight:400;letter-spacing:1rpx}.podium-name{font-size:24rpx;font-weight:400;line-height:1.5}.podium-score>text:first-child{font-family:var(--font-number);font-size:44rpx;font-weight:400;line-height:1.2;letter-spacing:0}.podium-slot-0 .podium-score>text:first-child{font-size:56rpx;font-weight:400;letter-spacing:0}.podium-score .podium-unit{font-size:19rpx;font-weight:400}.podium-plinth>text:first-child{font-family:var(--font-body);font-size:20rpx;font-weight:400;letter-spacing:0}.podium-avatar{font-size:29rpx}.podium-slot-0 .podium-avatar{font-size:36rpx}.position-rank>text{font-family:var(--font-number);font-size:44rpx;font-weight:400;letter-spacing:0}.position-rank>view{font-size:25rpx;font-weight:400}.position-rank>view>text{font-size:21rpx}.position-points>text:first-child{font-family:var(--font-number);font-size:38rpx;font-weight:400;letter-spacing:0}.position-points>text+text{font-size:21rpx}.position-bottom>text{font-size:22rpx}.position-bottom>button{font-size:24rpx;font-weight:500}.couple-board .ranking-section-title{font-family:var(--font-body);font-size:var(--text-section);font-weight:500;letter-spacing:0}.couple-board .ranking-section-heading{margin-top:34rpx}.couple-board .leaderboard-head{font-size:21rpx;color:var(--muted)}.couple-board .rank-name{font-size:26rpx;font-weight:400;line-height:1.5}.couple-board .rank-label{font-weight:400}.couple-board .rank-label>text{font-size:21rpx;font-weight:400}.couple-board .rank-number,.couple-board .rank-tier-1 .rank-number,.couple-board .rank-tier-2 .rank-number,.couple-board .rank-tier-3 .rank-number{font-family:var(--font-number);font-size:29rpx;font-weight:400}.couple-board .rank-points{display:flex;align-items:baseline;gap:6rpx}.couple-board .rank-points .rank-score-number{font-family:var(--font-number);font-size:36rpx;font-weight:400;line-height:1.2;letter-spacing:0;margin:0;color:var(--ink)}.couple-board .rank-points .rank-score-unit{font-family:var(--font-body);font-size:20rpx;font-weight:400;margin:0;color:var(--muted)}.couple-board .rank-emblem{width:48rpx;height:48rpx;font-size:22rpx}.couple-board .our-rank{background:#eaf0e2}.couple-board .our-rank .rank-name{font-weight:500}.couple-board .consent .section-title{font-size:27rpx;font-weight:500}.couple-board .consent .muted{font-size:22rpx}.season-entry>view>text,.couple-board .season-entry>view>text{font-size:27rpx;font-weight:500}.season-entry>view>text+text,.couple-board .season-entry>view>text+text{font-size:22rpx;font-weight:400}
/* Detail, weekly rewards and poster controls share the same hierarchy. */
.profile-copy>view{font-size:34rpx;font-weight:400;line-height:1.5}.profile-seal{font-size:20rpx!important}.profile-stats text:first-child{font-family:var(--font-number);font-size:44rpx;font-weight:400}.profile-stats text{font-size:22rpx}.comparison-card>view{font-family:var(--font-body);font-size:28rpx;font-weight:400;margin:16rpx 0}.comparison-card>text{font-size:22rpx}.privacy-note{font-size:26rpx;font-weight:400}.earned{font-family:var(--font-number);font-size:30rpx;font-weight:400}.score-row>view{font-size:26rpx;font-weight:400}.score-row>view>text{font-size:22rpx}
.period-tabs button,.poster-themes button{font-size:24rpx;font-weight:400}.reward-card{padding:28rpx}.reward-card-top{font-size:21rpx;font-weight:400}.reward-medal{width:128rpx;height:128rpx;margin:32rpx auto 24rpx}.reward-medal text{font-size:52rpx;font-weight:400}.reward-title{font-family:var(--font-title);font-size:36rpx;font-weight:400;line-height:1.5;letter-spacing:2rpx}.reward-subtitle{font-size:23rpx;font-weight:400;line-height:1.7}.reward-metrics text:first-child{font-family:var(--font-number);font-size:42rpx;font-weight:400}.reward-metrics text,.reward-rank>text{font-size:22rpx}.reward-rank{font-size:25rpx;font-weight:400}.claimed-note{font-size:24rpx}.reward-level{font-size:26rpx;font-weight:400}.reward-level>view>text,.reward-level>text{font-size:22rpx}.history-picker{font-size:24rpx}.poster-preview{margin:0 32rpx}.poster-actions button{font-weight:400}.flow-note{margin:24rpx 0}.rule-step>view{font-size:28rpx;font-weight:500}.rule-step>view>text{font-size:24rpx;font-weight:400;line-height:1.85}.rule-step>text{font-size:26rpx;font-weight:400;color:#7a866c}
/* Dialogs belong to the same product, including completion and note editing. */
.sheet .section-title{font-size:30rpx;font-weight:500}.sheet textarea{font-size:26rpx;line-height:1.8}.completion-points{font-family:var(--font-number);font-size:64rpx;font-weight:400}.completion-points>text{font-size:22rpx}.completion-sheet .reward-title{font-size:34rpx}.demo-toggle,.demo-tools{font-size:21rpx}.demo-season>text{font-size:23rpx}.demo-season>text+text{font-size:22rpx}
@keyframes screen-arrive{from{opacity:.35;transform:translateY(8rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes sheet-arrive{from{opacity:.5;transform:translateY(28rpx)}to{opacity:1;transform:translateY(0)}}
.page-screen{animation:screen-arrive 240ms ease-out both}.sheet{animation:sheet-arrive 220ms ease-out both}.page-screen.couple-board{animation:none}
@media(max-width:350px){page{--text-title:38rpx;--text-section:27rpx}.honour-heading>view>view{font-size:42rpx}.podium-name{font-size:22rpx}.podium-score>text:first-child{font-size:40rpx}.podium-slot-0 .podium-score>text:first-child{font-size:50rpx}.position-rank>view{font-size:24rpx}.position-bottom>text{font-size:21rpx}.couple-board .rank-name{font-size:25rpx}.couple-board .rank-points .rank-score-number{font-size:33rpx}.cover-title{font-size:35rpx}.poster-preview{margin:0 18rpx}}
@media(prefers-reduced-motion:reduce){.page-screen,.sheet{animation:none}.primary,.secondary,.text-button,.cover-action,.filter-chip,.idea-use,.idea-refresh,.activity{transition:none}}

/* Frequent date workflow stays in the date tab. */
.date-session{border:1rpx solid #dbe4d5;border-radius:18rpx;background:#f0f4e9;padding:28rpx;margin-top:26rpx}.date-session-top{display:flex;align-items:center;justify-content:space-between;font-size:22rpx;color:#62775b}.date-session-name{font-family:var(--font-title);font-size:38rpx;margin:28rpx 0 8rpx}.date-session-place{display:block;font-size:24rpx;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.date-session-time{padding:42rpx 0;text-align:center}.date-session-time>text{display:block;font-family:var(--font-title);font-size:50rpx;color:#30563d;line-height:1.4}.date-session-time>text+text{font-family:var(--font-body);font-size:23rpx;color:#697c60;margin-top:10rpx}.date-members{display:flex;border-top:1rpx solid #d9e1d1;border-bottom:1rpx solid #d9e1d1;padding:24rpx 0}.date-members>view{flex:1;text-align:center;font-size:25rpx}.date-members>view+view{border-left:1rpx solid #d9e1d1}.date-members text{display:block}.date-members text+text{font-size:22rpx;color:#67805a;margin-top:6rpx}.date-session-actions{display:flex;justify-content:space-between;margin-top:16rpx}.date-session-actions button{width:auto!important;max-width:none!important;margin:0;padding:18rpx 0;font-size:24rpx;color:#4b6944;min-height:76rpx}.date-session-actions button+button{color:#7a7868}.date-resume{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx;background:#edf3e5;border:1rpx solid #dbe4d0;border-radius:12rpx;margin:24rpx 0}.date-resume>view>text{display:block;font-size:27rpx}.date-resume>view>text+text{font-size:22rpx;color:var(--muted);margin-top:5rpx}.date-resume>text{font-size:24rpx;color:var(--accent);flex-shrink:0}

.activity-dock .primary[disabled]{opacity:1;background:#e5eadf!important;color:#697961!important}

/* Pairing is a first-use journey, not a buried account setting. */
.pair-cover{height:340rpx;position:relative;overflow:hidden;border-radius:24rpx;background:#254c40}.pair-cover>image,.pair-shade{position:absolute;width:100%;height:100%;inset:0}.pair-shade{background:linear-gradient(0deg,rgba(18,48,38,.86),rgba(18,48,38,.05))}.pair-cover-copy{position:absolute;left:34rpx;bottom:32rpx;color:#fff9e8}.pair-cover-copy>text{font-size:21rpx;letter-spacing:3rpx;opacity:.8}.pair-cover-copy>view{font-family:'Songti SC',serif;font-size:43rpx;font-weight:400;line-height:1.5;margin-top:12rpx}.pair-paper{padding:32rpx 0;border-bottom:1rpx solid #dedfd3}.pair-step{font-size:21rpx;color:#718071;letter-spacing:2rpx;margin-bottom:14rpx}.pair-paper>.muted{display:block;margin:12rpx 0 22rpx;line-height:1.7}.pair-mode{padding:22rpx 24rpx;background:#eee9d9;border-radius:12rpx;margin-top:24rpx;font-size:24rpx;color:#635940}.pair-mode>text,.pair-wait>text{display:block;font-size:22rpx;margin-top:8rpx;line-height:1.6}.pair-code{font-family:Georgia,serif;font-size:38rpx;letter-spacing:4rpx;padding:24rpx 0;color:#244f40}.pair-code>text{display:block;font-family:inherit;font-size:21rpx;letter-spacing:0;color:#768170;margin-top:12rpx}.pair-wait{padding-top:20rpx;font-size:24rpx;color:#596e5f}.pair-code-input{letter-spacing:2rpx;margin-bottom:18rpx}.pair-accept .secondary{width:100%}

/* Account lifecycle surfaces follow the existing editorial type scale. */
.settings-link{margin:0 0 20rpx auto;padding:0;background:transparent;color:#386554;font-size:24rpx;line-height:44rpx;text-align:right}.settings-link::after,.settings-row::after{border:0}.settings-section{padding:34rpx 0;border-bottom:1rpx solid #dedfd5}.settings-section .input{margin:24rpx 0}.settings-row{display:flex;justify-content:space-between;align-items:center;gap:18rpx;padding:26rpx 0;text-align:left;background:transparent;font-size:27rpx;font-weight:400;line-height:1.6;border-radius:0}.settings-row text{font-size:23rpx;color:#738273}.privacy-copy{display:block;margin-top:18rpx;font-size:26rpx;line-height:1.9;color:#59665c}.danger-text{color:#953e4a!important}

.settings-row{width:100%;margin:0;color:#263e32}.settings-section .input{height:88rpx;box-sizing:border-box;padding:0 24rpx}
/* Keep action contrast reliable in dynamically mounted native template branches. */
button.primary{background:#276653;color:#fff}
button.primary[disabled]{background:#e5eadf;color:#697961;opacity:1}
