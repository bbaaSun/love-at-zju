.trial-pair-link{display:flex;justify-content:space-between;font-size:21rpx;color:#7e877b;padding:18rpx 0;border-bottom:1rpx solid #e7eae1}.trial-pair-link text{color:#315f4d}.trial-page .page-title{font-size:40rpx;font-weight:500;line-height:1.4;margin:18rpx 0}.trial-eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#839078;margin-top:30rpx}.trial-intro{font-size:25rpx;color:#71806a;line-height:1.8;display:block;max-width:540rpx}.trial-progress{height:4rpx;background:#e8eddf;border-radius:6rpx;margin:32rpx 0 8rpx;overflow:hidden}.trial-progress>view{height:100%;background:#50764e;transition:width .3s}.trial-step{display:flex;align-items:center;gap:24rpx;width:100%!important;text-align:left;padding:30rpx 0;margin:0;background:transparent;border-radius:0;border-bottom:1rpx solid #e8ebe3;white-space:normal;line-height:1.5}.trial-number{font-family:Georgia,serif;font-size:36rpx;color:#a3b093;width:50rpx;flex-shrink:0}.trial-number.done{font-family:inherit;color:#386645}.trial-step>view{flex:1}.trial-step>view>text{display:block;font-size:28rpx;font-weight:500;color:#2e493a}.trial-step>view>text+text{font-size:22rpx;font-weight:400;color:#7c8773;margin-top:7rpx}.trial-step>text:last-child{color:#6a805b;font-size:23rpx}.trial-note{margin:30rpx 0;padding:24rpx;background:#f3f5ee;border-radius:16rpx;font-size:25rpx;color:#446140}.trial-note text{display:block;line-height:1.8;font-size:22rpx;color:#7b866f;margin-top:10rpx}.trial-feedback{margin:20rpx 0;padding:22rpx;box-sizing:border-box;width:100%;height:180rpx;background:#f8f9f5;border:1rpx solid #e0e6d8;border-radius:12rpx;font-size:24rpx;line-height:1.7}.trial-footnote{display:block;font-size:21rpx;color:#8b9181;line-height:1.9;margin-top:28rpx}.import-summary{display:flex;align-items:center;gap:18rpx;margin:28rpx 0 18rpx}.import-summary>text{font-family:Georgia,serif;font-size:58rpx;color:#294e3b;line-height:1}.import-summary>view{font-size:23rpx;color:#456044}.import-summary>view>text{display:block;font-size:20rpx;color:#849077;margin-top:7rpx}.import-editor .primary{margin-top:20rpx}.page-trial>.topline{display:none}
