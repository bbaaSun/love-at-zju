
.school-captcha{width:280rpx;height:100rpx;display:block;margin:20rpx 0;}
.course-view-switch{display:flex;align-items:center;gap:12rpx;margin:24rpx 0}.course-view-switch button{margin:0;padding:10rpx 22rpx;font-size:24rpx;line-height:1.5;background:transparent;color:#66756e}.course-view-switch button.selected{background:#e8eee8;color:#214e40}.course-view-switch>text{margin-left:auto;font-size:22rpx;color:#737e76}.course-grid-scroll{width:100%;margin:18rpx 0;border:1rpx solid #e5e9e2;border-radius:20rpx;background:#fff}.course-grid-canvas{width:1020rpx}.course-grid-head{position:relative;height:82rpx;background:#f2f5ee}.course-grid-head>view{position:absolute;height:82rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;font-size:24rpx}.course-grid-head .chosen{background:#dfeade;color:#245641}.course-grid-body{height:1300rpx;position:relative}.course-grid-rule{position:absolute;left:0;width:100%;height:100rpx;border-top:1rpx solid #edf0e9}.course-grid-rule>view{width:68rpx;display:flex;flex-direction:column;align-items:center;padding-top:8rpx}.course-grid-rule text:first-child{font-size:18rpx;color:#89938c}.course-grid-rule text:last-child{font-size:26rpx;color:#66746b}.course-grid-event{position:absolute;box-sizing:border-box;padding:12rpx 10rpx;border-radius:12rpx;background:#e0ebdf;color:#204b39;overflow:hidden;border-left:4rpx solid #3d775d}.course-grid-event.owner-partner{background:#eee7f3;color:#634774;border-left-color:#9473ac}.course-grid-event>view{font-size:24rpx;line-height:1.35;font-weight:500}.course-grid-event>text{display:block;font-size:21rpx;line-height:1.35;margin-top:8rpx;opacity:.8}.course-grid-event .course-grid-time{font-size:18rpx}
