<view class="app page-{{tab}} {{tab === 'activities' && room.active ? 'with-dock' : ''}}">
 <view class="topline {{demo ? 'demo-topline' : ''}}"><text>浙天遇见你</text><text wx:if="{{demo}}" class="mode-tag">演示</text></view>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}<text bindtap="refresh"> 重新加载</text></view>
 <view wx:if="{{!room}}" class="empty"><text>{{busy ? '正在打开我们的空间…' : '暂时无法打开空间'}}</text><button wx:if="{{!busy}}" bindtap="refresh">重试</button></view>
 <block wx:if="{{room}}">
 <view wx:if="{{tab === 'pair'}}" class="page-screen pair-page">
 <view class="visual-heading"><text>组成我们</text><button class="icon-button" data-tab="settings" bindtap="tab" aria-label="设置">⚙</button></view>
 <view class="pair-scene"><view class="duo "><view><image src="/assets/visual/owner-a.png"/><text>{{room.members[0].name}}</text></view><image class="duo-heart" src="/assets/visual/heart.png"/><view><image src="/assets/visual/owner-b.png"/><text>{{room.paired ? room.members[1].name : 'TA'}}</text></view></view><view class="pair-connector">{{room.paired ? '✓' : '＋'}}</view></view>
 <block wx:if="{{room.paired}}"><view class="pair-success">已绑定</view><button class="primary" data-tab="activities" bindtap="tab">发起约会</button><button class="text-button" data-tab="home" bindtap="tab">进入空间</button></block>
 <block wx:else><view wx:if="{{demo}}" class="visual-notice">本机模拟 · 不支持跨设备邀请</view>
 <block wx:if="{{!demo}}"><button wx:if="{{!room.invite || inviteExpired}}" class="primary" bindtap="invite" disabled="{{busy}}">{{inviteExpired ? '重新生成邀请' : '邀请 TA'}}</button><block wx:else><view class="pair-code" bindtap="copy">{{room.invite.code}}<text>点击复制 · 24 小时有效</text></view><button class="primary" bindtap="copy">复制邀请码</button><button class="text-button" bindtap="revokeInvite" disabled="{{busy}}">撤销邀请</button><view class="pair-wait"><view class="waiting-dots"><text></text><text></text><text></text></view>等待 TA 加入</view></block></block>
 <button wx:else class="primary" data-action="demoPair" bindtap="act" disabled="{{busy}}">模拟绑定</button>
 <view class="pair-accept"><view class="field-label">我有邀请码</view><input class="input" aria-label="12位邀请码" placeholder="输入 12 位邀请码" value="{{code}}" maxlength="24" data-field="code" bindinput="input"/><button class="secondary" bindtap="joinRoom" disabled="{{busy || !code}}">加入</button></view></block>
 <view class="pair-links"><button class="text-button" data-tab="board" bindtap="tab">先看榜单 ↗</button><button class="text-button" data-tab="trial" bindtap="tab">使用帮助</button></view>
 <view class="visual-notice">约会与回忆仅双方可见 · 上榜需另行同意</view></view>

 <view wx:if="{{tab === 'home'}}" class="page-screen couple-home">
 <view class="space-heading"><view><text class="space-eyebrow">OUR LITTLE UNIVERSE</text><text class="space-title">情侣空间</text></view><button class="space-gear" data-tab="settings" bindtap="tab" aria-label="空间设置">⚙</button></view>
 <view class="space-identity"><view><image src="/assets/visual/owner-a.png"/><text>{{room.members[0].name}}</text></view><text class="space-link">∞</text><view><image src="/assets/visual/owner-b.png"/><text>{{room.members[1].name}}</text></view></view>
 <view class="spark-stage {{room.spaceView.lit ? 'is-lit' : ''}}"><view class="spark-orbit orbit-one"></view><view class="spark-orbit orbit-two"></view><view class="spark-stars">✧<text>✦</text></view><view class="spark-halo"></view><view class="spark-sculpture"><view class="spark-core"></view></view><view class="spark-plinth"></view><view class="spark-caption"><text>星火</text><text>Lv.{{room.spaceView.level}} · {{room.spaceView.lit ? '今日已一起点亮' : '等两束光相遇'}}</text></view></view>
 <view class="spark-growth"><text>共同点亮 {{room.spaceView.totalDays}} 天</text><view><view style="{{uiSpaceProgress}}"></view></view><text>{{room.spaceView.remaining ? '再点亮 ' + room.spaceView.remaining + ' 天升级' : '已长成恒星'}}</text></view>
 <view class="spark-actions"><view class="spark-status"><text class="{{room.spaceView.sparkMine ? 'on' : ''}}">我 {{room.spaceView.sparkMine ? '●' : '○'}}</text><text class="{{room.spaceView.sparkPartner ? 'on' : ''}}">TA {{room.spaceView.sparkPartner ? '●' : '○'}}</text></view><button class="spark-button" bindtap="spaceSpark" disabled="{{busy || room.spaceView.sparkMine}}">{{room.spaceView.lit ? '今天也在一起' : room.spaceView.sparkMine ? '等 TA 点亮' : '点亮我们的星火'}}</button></view>
 <view class="space-anniversary"><view><text>相恋的第</text><view>{{room.spaceView.days}}<text>天</text></view></view><view class="anniversary-edit"><text>{{room.spaceView.anniversary || '从绑定空间开始'}}</text><picker mode="date" value="{{room.spaceView.anniversary}}" bindchange="spaceDate"><text>设置相恋日 ↗</text></picker></view></view>
 <view class="space-portals"><button bindtap="enterToday"><image src="/assets/visual/heart.png"/><text>{{room.active ? '继续约会' : '一起约会'}}</text></button><button bindtap="openTimetable"><image src="/assets/visual/calendar.png"/><text>双人课表</text></button><button data-tab="journal" bindtap="tab"><image src="/assets/visual/folder.png"/><text>共同回忆</text></button><button bindtap="openSeason"><image src="/assets/visual/medal.png"/><text>纪念收藏</text></button></view>
 <view class="space-section-title"><text>一起，慢慢实现</text><button bindtap="spaceWishEditor" aria-label="添加共同心愿">{{spaceEditor ? '取消' : '＋'}}</button></view>
 <view wx:if="{{spaceEditor}}" class="space-wish-editor"><input value="{{spaceWishText}}" maxlength="40" data-field="spaceWishText" placeholder="例如：一起看一次日出" bindinput="spaceWishInput"/><button bindtap="spaceWishSave" disabled="{{busy}}">保存</button></view>
 <view wx:if="{{!room.spaceView.wishes.length && !spaceEditor}}" class="space-wish-empty" bindtap="spaceWishEditor"><text>○</text><text>写下第一个共同心愿</text><text>↗</text></view>
 <view wx:for="{{room.spaceView.wishes}}" wx:key="id" class="space-wish {{item.done ? 'done' : ''}}"><button data-id="{{item.id}}" data-done="{{item.done}}" bindtap="spaceWishToggle" disabled="{{busy}}"><text>{{item.done ? '✓' : '○'}}</text>{{item.text}}</button><button data-id="{{item.id}}" bindtap="spaceWishRemove" aria-label="移除心愿" disabled="{{busy}}">×</button></view>
 <view class="space-section-title"><text>这周的共同足迹</text><text>{{weekCount}} 天</text></view><view class="week-days space-week"><view wx:for="{{weekDays}}" wx:key="key" class="week-day {{item.today ? 'is-today' : ''}}"><text>{{item.label}}</text><view class="day-dot {{item.done ? 'done' : ''}}">{{item.done ? '✓' : item.day}}</view></view></view>
 <view class="consent"><view><text>在情侣榜留下名字</text><text>{{room.myVote && !room.listed ? '等待 TA 同意' : '双方同意后公开组合名与积分'}}</text></view><switch aria-label="同意参与情侣榜" color="#54768b" checked="{{room.myVote}}" bindchange="vote" disabled="{{busy || !room.paired}}"/></view>
 <text class="space-footnote">星火由双方每日点亮，不计入榜单积分</text>
 </view>

 <view wx:if="{{tab === 'settings'}}" class="flow-page page-screen">
  <button class="flow-back" data-tab="home" bindtap="tab">‹ 情侣空间</button><view class="visual-heading"><text>设置</text><image class="heading-art" src="/assets/visual/heart.png"/></view><view class="account-identity"><image src="/assets/visual/owner-a.png"/><text>{{room.me === room.members[0].id ? room.members[0].name : room.members[1].name}}</text></view>
  <view class="settings-section"><view class="field-label">我的昵称 <text>仅彼此可见</text></view><input class="input" value="{{nickname}}" maxlength="16" data-field="nickname" bindinput="input" placeholder="你的昵称，最多 16 个字"/><button class="primary" bindtap="saveProfile" disabled="{{busy || !nickname}}">保存昵称</button></view>
  <view class="settings-section"><button class="settings-row" data-tab="trial" bindtap="tab">使用帮助 <text>{{releaseVersion}} ↗</text></button><button class="settings-row" bindtap="openArchives">历史空间 <text>↗</text></button><button class="settings-row" data-tab="privacy" bindtap="tab">数据与隐私 <text>↗</text></button><button class="settings-row" data-tab="rules" bindtap="tab">积分规则 <text>↗</text></button></view>
  <view wx:if="{{room.paired}}" class="settings-section"><view class="section-title">情侣关系</view><text class="muted">{{room.members[0].name}} · {{room.members[1].name}}</text><button class="text-button danger-text" bindtap="leaveRoom" disabled="{{busy}}">解除情侣绑定</button></view>
 </view>
 <view wx:if="{{tab === 'trial'}}" class="page-screen trial-page">
  <button class="flow-back" data-tab="settings" bindtap="tab">‹ 设置</button>
  <image class="trial-art" src="/assets/visual/heart.png"/>
  <view class="page-title">开始体验</view>
  
  <view class="trial-progress"><view style="{{trialProgress}}"></view></view>
  <button wx:for="{{trialSteps}}" wx:key="action" class="trial-step" bindtap="trialStep" data-action="{{item.action}}"><text class="trial-number {{item.done ? 'done' : ''}}">{{item.done ? '✓' : '0' + (index + 1)}}</text><view><text>{{item.title}}</text><text wx:if="{{uiPanels.trial}}">{{item.detail}}</text></view><text>↗</text></button>
  <button class="disclosure" data-key="trial" bindtap="uiToggle" aria-expanded="{{uiPanels.trial ? true : false}}"><text>使用说明</text><text>{{uiPanels.trial ? '−' : '＋'}}</text></button><view wx:if="{{uiPanels.trial}}" class="trial-note"><view>邀请码 ≠ 体验二维码</view><text>队友先用自己的微信扫码打开体验版，再输入另一半的邀请码。提示没有体验权限时，请让发码的队友添加体验成员。</text></view>
  <view class="section-title">有哪里不顺手？</view><textarea class="trial-feedback" placeholder="例如：我发起听歌后，另一台手机没有显示…" value="{{feedbackText}}" maxlength="500" data-field="feedbackText" bindinput="input"/><button class="secondary" bindtap="copyTrialFeedback">复制问题描述，发给团队</button>
  <text wx:if="{{uiPanels.trial}}" class="trial-footnote">试用积分按双方确认计算，尚未验证同地或学籍。课表支持账号登录导入，或选择教务导出的课表文件。</text>
 </view>
 <view wx:if="{{tab === 'archives'}}" class="flow-page page-screen"><button class="flow-back" data-tab="settings" bindtap="tab">‹ 设置</button><view class="visual-heading"><text>历史空间</text><image class="heading-art" src="/assets/visual/folder.png"/></view><text class="muted">原伴侣可见 · 只读保存</text>
  <block wx:if="{{archiveDetail}}"><button class="text-button" bindtap="closeArchive">← 全部历史空间</button><view class="section-title">{{archiveDetail.members[0].name}} · {{archiveDetail.members[1].name}}</view><view wx:if="{{!archiveDetail.records.length}}" class="empty">这段同行还没有留下已完成的回忆。</view><view wx:for="{{archiveDetail.records}}" wx:key="id" class="memory archive-memory"><image class="archive-icon" src="/assets/visual/{{item.type}}.png"/><view class="date">{{item.date}}</view><view class="memory-title">{{item.name}}<text>+{{item.points}}</text></view><text class="muted">{{item.note || item.place || '一起度过的时间，值得被记住。'}}</text></view></block>
  <block wx:else><view wx:if="{{!archives.length}}" class="visual-empty"><image src="/assets/visual/folder.png"/><text>{{busy ? '正在读取…' : '还没有归档的空间'}}</text></view><button wx:for="{{archives}}" wx:key="id" class="archive-folder" data-id="{{item.id}}" bindtap="viewArchive"><image src="/assets/visual/folder.png"/><view>{{item.members[0].name}} · {{item.members[1].name}}<text>{{item.records.length}} 段回忆</text></view><text>↗</text></button><button wx:if="{{archiveOffset !== null}}" class="text-button" bindtap="moreArchives" disabled="{{busy}}">加载更多</button></block>
 </view>
 <view wx:if="{{tab === 'privacy'}}" class="flow-page page-screen"><button class="flow-back" data-tab="settings" bindtap="tab">‹ 设置</button><view class="privacy-hero"><image src="/assets/visual/lock.png"/><text>数据与隐私</text></view><view class="privacy-trio"><view>♡<text>回忆私密</text></view><view>◉<text>共享自选</text></view><view>✓<text>随时退出</text></view></view>
  <view class="settings-section"><button class="disclosure" data-key="privacy0" bindtap="uiToggle" aria-expanded="{{uiPanels.privacy0 ? true : false}}"><text>保存哪些内容</text><text>{{uiPanels.privacy0 ? '−' : '＋'}}</text></button><text wx:if="{{uiPanels.privacy0}}" class="privacy-copy">使用微信云端身份区分账号，保存昵称、情侣绑定、活动计划、双方参与和完成时间、感想与积分。使用课表功能时保存你确认录入的课程名称、日期、起止时间和地点。教务导入时，密码在手机端加密后经云服务提交学校；不保存明文密码或已登录会话。当前不采集定位、手机号或学生证。填写计划和感想时，请避免填写证件或详细住址。</text></view>
  <view class="settings-section"><button class="disclosure" data-key="privacy1" bindtap="uiToggle" aria-expanded="{{uiPanels.privacy1 ? true : false}}"><text>谁可以看到</text><text>{{uiPanels.privacy1 ? '−' : '＋'}}</text></button><text wx:if="{{uiPanels.privacy1}}" class="privacy-copy">绑定后双方共享约会和回忆。双方同意后，榜单公开匿名组合、名次和周积分；任一方可以关闭上榜。昵称、计划和感想不会出现在公开名片。课表默认仅本人可见；主动开启共享后，当前伴侣可见，随时可以关闭共享或删除自己的课表。</text></view>
  <view class="settings-section"><button class="disclosure" data-key="privacy2" bindtap="uiToggle" aria-expanded="{{uiPanels.privacy2 ? true : false}}"><text>解除之后</text><text>{{uiPanels.privacy2 ? '−' : '＋'}}</text></button><text wx:if="{{uiPanels.privacy2}}" class="privacy-copy">双方恢复独立空间，旧空间退出本周榜单，已完成回忆以只读方式保留给原来的两个人。当前每个空间保留最近 300 条回忆，周积分账本单独保存。解除绑定不等于删除历史数据。课表归本人保留，停止向旧伴侣共享，也不会自动向新伴侣共享。</text></view>
  <view class="settings-section"><button class="disclosure" data-key="privacy3" bindtap="uiToggle" aria-expanded="{{uiPanels.privacy3 ? true : false}}"><text>海报与试测</text><text>{{uiPanels.privacy3 ? '−' : '＋'}}</text></button><text wx:if="{{uiPanels.privacy3}}" class="privacy-copy">纪念海报在设备上生成，只有你选择保存时才申请相册权限。当前积分基于双人确认，不代表已验证同地或浙大学籍；本产品由学生团队独立制作，不代表学校官方。数据问题请通过本次课程试测的组织者联系开发团队。</text></view>
 </view>
 <view wx:if="{{tab === 'activities'}}" class="page-screen visual-activities date-hub"><view class="visual-heading"><text>约会</text><button class="icon-button" data-tab="rules" bindtap="tab" aria-label="积分规则">ⓘ</button></view>
 <button wx:if="{{!room.active}}" class="date-compass date-launch" bindtap="uiDatePlan" aria-label="发起约会"><view class="compass-ring"></view><view class="compass-ring inner"></view><view class="compass-gem"><image src="/assets/visual/{{selected}}.png"/></view><text class="compass-star">✦</text><view class="compass-caption"><text>发起约会 ↗</text></view></button>
 <view wx:if="{{room.active}}" class="date-session">
  <view class="session-illustration"><image src="/assets/visual/{{room.active.type}}.png"/></view><view class="date-session-top"><image class="plan-icon" src="/assets/icons/{{room.active.type}}.png"/><text>{{room.active.status}}</text></view>
  <view class="date-session-name">{{room.active.name}}</view><text wx:if="{{room.active.place}}" class="date-session-place">{{room.active.place}}</text>
  <view class="date-session-time"><view wx:if="{{room.active.startedAt !== null}}" class="timer-orbit" style="{{uiTimerStyle}}"><view></view></view><text>{{room.active.startedAt === null ? '等你一起' : room.active.hasFinished ? '已确认' : room.active.remaining > 0 ? room.active.remaining : '可以完成'}}</text><text>{{room.active.startedAt === null ? '双方加入后开始计时' : room.active.hasFinished ? '另一半确认后共同计分' : room.active.remaining > 0 ? '分钟后可确认完成' : '双方确认后记录这次约会'}}</text></view>
  <view class="date-members"><view><image src="/assets/visual/owner-a.png"/><text>我</text><text>{{room.active.canJoin ? '待加入' : room.active.hasFinished ? '已完成' : '已加入'}}</text></view><view><image src="/assets/visual/owner-b.png"/><text>TA</text><text>{{room.active.finished.length > (room.active.hasFinished ? 1 : 0) ? '已完成' : room.active.joined.length > (room.active.canJoin ? 0 : 1) ? '已加入' : '待加入'}}</text></view></view>
  <view class="date-session-actions"><button data-id="{{room.active.id}}" bindtap="edit">记录这一刻</button><button data-action="cancel" bindtap="act" disabled="{{busy}}">取消约会</button></view>
 </view>

 <view class="date-record-heading"><text>约会记录</text><text>{{room.records.length}} 次</text></view>
 <view wx:if="{{!room.records.length}}" class="date-record-empty"><view class="empty-record-line"></view><text>第一次约会，等你们开启</text></view>
 <view class="date-records"><button wx:for="{{room.records}}" wx:key="id" class="date-record" data-id="{{item.id}}" bindtap="uiOpenRecord"><view class="record-symbol"><image src="/assets/visual/{{item.type}}.png"/></view><view class="record-copy"><text>{{item.name}}</text><text>{{item.date}}{{item.place ? ' · ' + item.place : ''}}</text></view><text class="record-arrow">↗</text></button></view>
 </view>
 <view wx:if="{{tab === 'datePlan'}}" class="page-screen visual-activities date-plan"><button class="flow-back" data-tab="activities" bindtap="tab">‹ 约会</button><view class="visual-heading"><text>这次约什么</text></view>
<view class="activity-grid"><button wx:for="{{types}}" wx:key="id" class="activity activity-{{item.id}} {{selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="select" aria-label="{{item.name}}，{{item.points}}积分"><image src="/assets/visual/{{item.id}}.png"/><text>{{item.label}}</text><view class="activity-check">{{selected === item.id ? '✓' : ''}}</view></button></view>
<view class="plan-selection"><text>{{selectedType.name}}</text><text>{{selectedType.minutes ? selectedType.minutes + ' 分钟 · ' : ''}}双方确认后 +{{selectedType.points}} 积分</text></view>
 <view class="plan-detail"><button class="disclosure" data-key="plan" bindtap="uiToggle" aria-expanded="{{uiPanels.plan ? true : false}}"><text>添加地点 / 计划</text><text>{{uiPanels.plan ? '−' : '＋'}}</text></button><view wx:if="{{uiPanels.plan || place}}"><input class="input" aria-label="活动地点或计划" placeholder="想去哪儿？" value="{{place}}" maxlength="40" data-field="place" bindinput="input"/><view class="idea-box"><view class="idea-heading"><text>灵感</text><button class="idea-refresh" bindtap="nextIdea">换一个 ↻</button></view><view class="idea-copy">{{ideas[ideaIndex]}}</view><button class="idea-use" data-idea="{{ideas[ideaIndex]}}" bindtap="useIdea">用这个</button></view></view></view>
<button class="primary plan-start" bindtap="start" disabled="{{busy}}">邀请 TA 一起{{selectedType.label}} ↗</button></view>

 <view wx:if="{{tab === 'timetable'}}" class="page-screen schedule-page">

 <view class="visual-heading schedule-heading"><text>情侣课表</text><button class="small-pill" bindtap="openSchool" disabled="{{busy || importBusy || !timetable}}">＋ 导入</button></view>
 <view wx:if="{{!timetable}}" class="empty">{{busy || courseLoading ? '正在加载双人课表…' : '课表暂时无法加载'}}<button wx:if="{{!busy}}" bindtap="openTimetable">重新加载</button></view>
 <block wx:if="{{timetable}}">
 <view class="course-week"><button data-delta="-1" bindtap="courseShift" aria-label="上一周">←</button><view>{{uiCourseRange}}<button class="course-today" bindtap="courseToday">今天</button></view><button data-delta="1" bindtap="courseShift" aria-label="下一周">→</button></view>
 <view wx:if="{{courseView === 'list'}}" class="course-days"><view wx:for="{{courseDays}}" wx:key="date" class="{{courseDate === item.date ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="courseDay"><text>{{item.label}}</text><text>{{item.day}}</text></view></view>
 <view class="course-modes"><button class="{{courseMode === 'mine' ? 'selected' : ''}}" data-mode="mine" bindtap="courseMode">我的</button><button class="{{courseMode === 'both' ? 'selected' : ''}}" data-mode="both" bindtap="courseMode">双人</button><button class="{{courseMode === 'partner' ? 'selected' : ''}}" data-mode="partner" bindtap="courseMode">TA 的</button></view>
 <view class="course-view-switch"><button class="{{courseView === 'week' ? 'selected' : ''}}" data-view="week" bindtap="setCourseView">周课表</button><button class="{{courseView === 'list' ? 'selected' : ''}}" data-view="list" bindtap="setCourseView">当日详情</button><view wx:if="{{courseMode === 'both'}}" class="course-legend"><text>● 我</text><text>● TA</text></view></view>
 <block wx:if="{{courseView === 'week'}}">
  <view class="grid-hint">周一至周日 <text>左右滑动 ↔</text></view>
  <scroll-view scroll-x="{{true}}" class="course-grid-scroll">
   <view class="course-grid-canvas">
    <view class="course-grid-head"><view wx:for="{{courseGridHeaders}}" wx:key="date" style="{{item.style}}" class="{{courseDate === item.date ? 'chosen' : ''}}" data-date="{{item.date}}" bindtap="courseDay"><text>周{{item.label}}</text><text>{{item.day}}</text></view></view>
    <view class="course-grid-body"><view wx:for="{{courseGridTicks}}" wx:key="section" class="course-grid-rule" style="{{item.style}}"><view><text>{{item.start}}</text><text>{{item.section}}</text></view></view><view wx:for="{{courseGrid}}" wx:key="id" class="course-grid-event owner-{{item.owner}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="showCourse" role="button" aria-label="{{item.title}}，{{item.date}}，{{item.time}}，{{item.place}}"><view>{{item.title}}</view><text>{{item.place}}</text><text class="course-grid-time">{{item.time}}</text><text class="course-owner-mark">{{item.owner === 'partner' ? 'TA' : '我'}}</text></view></view>
   </view>
  </scroll-view>
  <view wx:if="{{!courseGrid.length}}" class="course-empty">本周暂没有可显示的课程。未导入或未共享的日期不能视为空闲。</view>
